#!/usr/bin/env zsh

showHelp () {
cat << EOF

SYNOPSIS
	usb                    list available devices
	usb DEVICE COMMAND     change state of a given device

ARGUMENTS
	DEVICE     part of the device's name (case insensitive),
	           spaces can be written as _ (as in the completions)
	COMMAND    one of the available commands:
	           on off restart

EXAMPLES
	Show available devices:

		$ usb
		Maxxter Wireless Optical Mouse ACT-MUSW-002
		Kinesis Corporation Advantage2 Keyboard
		SM950 Microphon SM950 Microphone
		Realtek Semiconductor Corp. Thronmax StreamGo Webcam
		Cambridge Silicon Radio, Ltd Bluetooth Dongle (HCI mode)

	Restart a device (pass a phrase to grep by).
	Below examples are equvalent:

		$ usb Kinesis restart
		$ usb kinesis restart
		$ usb keyboard restart
		$ usb Kinesis_Corporation_Advantage2_Keyboard restart

EOF
}

if [[ $1 == "-h" ]]; then
	showHelp
	exit
fi

device_name=$1
command=$2

devices=$(lsusb | grep -iv "hub$" | cut -d ' ' -f6-)
devices_human=$(echo "$devices" | cut -d ' ' -f2-)

if [ -z "$device_name" ]; then
	echo "$devices_human"
	exit
fi

if [ -z "$command" ]; then
	echo "No command, available commands:"
	echo 'on off restart'
	exit 1
fi

# The completions offer the names with _ instead of spaces, so the name is
# matched (as a plain substring) against the device lines with spaces turned to _.
selected_device=$(printf '%s\n' "$devices" | awk -v name="${device_name// /_}" '
	{ line = $0; gsub(/ /, "_", line) }
	index(tolower(line), tolower(name))
')

if [ -z "$selected_device" ]; then
	echo 'Device not found, available devices:'
	echo "$devices_human"
	exit 1
fi
if [ "$(printf '%s\n' "$selected_device" | wc -l)" -gt 1 ]; then
	echo 'More than one device matches, be more specific:'
	printf '%s\n' "$selected_device" | cut -d ' ' -f2-
	exit 1
fi
echo "Selected device: $selected_device"

# The first field is vendor:product, eg 046d:c52b.
id="${selected_device%% *}"
vendor="${id%%:*}"
product="${id#*:}"
echo "Vendor: $vendor, product: $product"

# Find the device's address (eg 1-2) in sysfs by its vendor and product id.
# The device stays listed there also when it's unbound (turned off).
device_address=''
for dev in /sys/bus/usb/devices/*(N); do
	[ -r "$dev/idVendor" ] && [ -r "$dev/idProduct" ] || continue
	if [ "$(<"$dev/idVendor")" = "$vendor" ] && [ "$(<"$dev/idProduct")" = "$product" ]; then
		device_address="${dev:t}"
		break
	fi
done

if [ -z "$device_address" ]; then
	echo "Device address not found"
	exit 1
fi
echo "Device address: $device_address"

# TODO: check bind/unbind files perms
case $command in
	on)
		echo "$device_address" > /sys/bus/usb/drivers/usb/bind
		;;
	off)
		echo "$device_address" > /sys/bus/usb/drivers/usb/unbind
		;;
	restart)
		echo "$device_address" > /sys/bus/usb/drivers/usb/unbind
		sleep 1
		echo "$device_address" > /sys/bus/usb/drivers/usb/bind
		;;
	*)
		echo "Unknown command"
		exit 1
esac

if [ $? -eq 1 ]; then
	echo ""
	echo "If you're getting the permission denied error, here's a possible workaround:"
	echo "    $ su -c \"crontab -e\""
	echo "    $ @reboot chmod a+w /sys/bus/usb/drivers/usb/bind /sys/bus/usb/drivers/usb/unbind"
fi
