#!/usr/bin/env zsh

# kmtrashpath walks up the current path trying to locate the nearest .trash dir.
# If .trash dir is not found, it prints the $HOME/.trash, which is the default
# trash path.

# Lookup trash path up the current path, starting from the current dir.
dir="$PWD"
while true; do
	if [ -d "$dir/.trash" ]; then
		trash_path="$dir/.trash/"
		break
	fi

	[ "$dir" = / ] && break
	dir="${dir:h}"
done

# If trash not found, use default trash path.
if [ -z "$trash_path" ]; then
	trash_path="$HOME/.trash/"
fi

printf '%s\n' "$trash_path"
