#!/usr/bin/env zsh

show_help() {
	cat <<'EOF'

NAME
	video_frames_split

SYNOPSIS
	video_frames_split [FILENAME...] [OPTION...]
	video_frames_split -f FILES [OPTION...]

ARGUMENTS
	FILENAME            source video file

OPTIONS
	-h, --help          display this help and exit
	-j, --jobs JOBS     number of parallel jobs (default: 1)
	-f, --files FILES   newline-separated source file names
	                    (positional filenames are ignored)
	-d, --dir DIR       destination directory
	                    (default: $VIDEO_FRAMES_DIR)
	-n, --name NAME     output directory name
	                    (defaults to each file's basename)

EOF
}

jobs=1
name=''
dir="${VIDEO_FRAMES_DIR:-}"
files=''

parsed_options=$(
	getopt \
		-o 'hj:f:d:n:' \
		-l 'help,jobs:,files:,dir:,name:' \
		-- "$@"
) || exit 2

eval set -- "$parsed_options"

while true; do
	case "$1" in
		-h|--help)
			show_help
			exit 0
			;;

		-j|--jobs)
			jobs="$2"
			shift 2
			;;

		-f|--files)
			files="$2"
			shift 2
			;;

		-d|--dir)
			dir="$2"
			shift 2
			;;

		-n|--name)
			name="$2"
			shift 2
			;;

		--)
			shift
			break
			;;

		*)
			print -u2 -- "Unknown option: $1"
			exit 2
			;;
	esac
done

if [[ -z "$dir" ]]; then
	print -u2 -- \
		'Video frames directory is not set. Set $VIDEO_FRAMES_DIR or provide --dir.'
	exit 1
fi

if [[ ! "$jobs" =~ '^[1-9][0-9]*$' ]]; then
	print -u2 -- "Invalid number of jobs: $jobs"
	exit 1
fi

typeset -a source_files
typeset -a job_commands

if [[ -n "$files" ]]; then
	# Split the value supplied through --files on newline characters.
	source_files=("${(@f)files}")
else
	if (( $# == 0 )); then
		print -u2 -- "No source files provided."
		exit 1
	fi

	source_files=("$@")
fi

integer i=1

for source_file in "${source_files[@]}"; do
	# Ignore empty lines in --files.
	[[ -n "$source_file" ]] || continue

	file=$(realpath -- "$source_file") || {
		print -u2 -- "Could not resolve file path: $source_file"
		exit 1
	}

	if [[ ! -f "$file" ]]; then
		print -u2 -- "File does not exist: $file"
		exit 1
	fi

	# Use --name when supplied. Otherwise, use the current file's
	# basename without its extension.
	current_name="${name:-${file:t:r}}"

	target_dir="${dir%/}/${current_name}"
	frame_dir=$(printf '%s_%02d_orig' "$target_dir" "$i")

	mkdir -p -- "$frame_dir" || {
		print -u2 -- "Could not create directory: $frame_dir"
		exit 1
	}

	# Store the original video path.
	print -r -- "$file" > "$frame_dir/path.txt"

	frames_pattern="$frame_dir/%05d.png"
	audio_file="$frame_dir/audio.mp4"
	framerate_file="$frame_dir/framerate.txt"

	job_commands+=(
		"ffmpeg -y -i ${(q)file} ${(q)frames_pattern}"
	)

	job_commands+=(
		"ffmpeg -y -i ${(q)file} -map 0:a -c copy ${(q)audio_file}"
	)

	job_commands+=(
		"ffprobe -select_streams v:0 -show_entries stream=r_frame_rate -of default=noprint_wrappers=1:nokey=1 ${(q)file} > ${(q)framerate_file}"
	)

	(( ++i ))
done

if (( ${#job_commands} == 0 )); then
	print -u2 -- "No valid source files provided."
	exit 1
fi

print -- '==='
print -- 'Commands:'
print -rl -- "${job_commands[@]}"

print -rl -- "${job_commands[@]}" |
	parallel --jobs "$jobs"
