#compdef kfind

# zsh autocompletion for the kfind script.

_arguments -s -S \
	'(- *)'{-h,--help}'[display help and exit]' \
	'(-f --files *)'{-f,--files}'[newline separated list of files or dirs]:file:_files' \
	'(-r --regex)'{-r,--regex}'[regex by which to filter the files]:regex:' \
	'(-s --shuffle)'{-s,--shuffle}'[display the results in a random order]' \
	'*:file or dir:_files'
