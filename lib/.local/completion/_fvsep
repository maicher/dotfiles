# DOT SKIP server
#compdef fvsep

# zsh autocompletion for the fvsep script.
#
# Set the FVSEP_CUSTOMERS env for better autocompletion, eg:
#   $ export FVSEP_CUSTOMERS="A B C"
#
_arguments -s -S \
	'(- *)'{-h,--help}'[display help and exit]' \
	'(-c --copy)'{-c,--copy}'[create also copies of the extracted pages]' \
	'(-p --prefix)'{-p,--prefix}'[add given phrase to the front of created result files]:prefix:' \
	'(-s --suffix)'{-s,--suffix}'[add given phrase to the end of the name of created result files]:suffix:' \
	'1:ods file:_km_files ods' \
	"*:page (_ to skip):(_ $FVSEP_CUSTOMERS)"
