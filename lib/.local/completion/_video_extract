#compdef video_extract

# zsh autocompletion for the video_extract script.
#
# The source videos need a <video>_markers.txt file next to them.

_arguments -s -S \
	'(- *)'{-h,--help}'[display help and exit]' \
	'(-j --jobs)'{-j,--jobs}'[number of parallel jobs (default: 1)]:jobs:' \
	'(-f --files *)'{-f,--files}'[newline separated list of source videos]:video:_km_files videos' \
	'(-o --out-dir)'{-o,--out-dir}'[output dir for generated parts]:dir:_files -/' \
	'(-p --parts)'{-p,--parts}'[generate a txt file with listed parts]' \
	'(-t --trash)'{-t,--trash}'[move source marker file to trash after processing]' \
	'(-v --verbose)'{-v,--verbose}'[show what the script is doing]' \
	'(-d --debug)'{-d,--debug}'[dump debug info into ./video_extract_debug.txt file]' \
	'*:video:_km_files videos'
