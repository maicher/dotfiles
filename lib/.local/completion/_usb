#compdef usb

# zsh autocompletion for the usb script.
#
# Device names are read from lsusb and offered with _ instead of spaces (the usb
# script matches them either way).
#
local curcontext="$curcontext" state line
typeset -A opt_args

local -a commands=(
	'on:bind the device'
	'off:unbind the device'
	'restart:unbind and bind the device again'
)

_arguments -C \
	'(- *)-h[display help]' \
	'1:device:->device' \
	'2:command:->command'

case $state in
	device)
		local -a devices
		# Same list as printed by the usb script (without the hubs).
		devices=(${${(f)"$(lsusb 2>/dev/null | grep -iv 'hub$' | cut -d ' ' -f7-)"}%%[[:space:]]#})
		devices=(${devices// /_})
		_wanted devices expl 'device' compadd -a devices
		;;
	command)
		_describe 'command' commands
		;;
esac
