#compdef image_rotate

# zsh autocompletion for the image_rotate script.

local rotation='-l --left -r --right -R --rotate'

_arguments -s -S \
	'(- *)'{-h,--help}'[display help and exit]' \
	'(-j --jobs)'{-j,--jobs}'[number of parallel jobs]:jobs:' \
	'(-f --files *)'{-f,--files}'[newline separated list of images]:image:_km_files images' \
	"($rotation)"{-l,--left}'[rotate 90 left (default)]' \
	"($rotation)"{-r,--right}'[rotate 90 right]' \
	"($rotation)"{-R,--rotate}'[rotate 180]' \
	'(-v --verbose)'{-v,--verbose}'[show what the script is doing]' \
	'(-d --debug)'{-d,--debug}'[dump debug info into ./debug.txt file]' \
	'*:image:_km_files images'
