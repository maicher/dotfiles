#compdef image_compress

# zsh autocompletion for the image_compress script.

_arguments -s -S \
	'(- *)'{-h,--help}'[display help and exit]' \
	'(-j --jobs)'{-j,--jobs}'[number of parallel jobs (default: 1)]:jobs:' \
	'(-f --files *)'{-f,--files}'[newline separated list of images]:image:_km_files images' \
	'(-q --quality)'{-q,--quality}'[target jpeg quality (default: 90)]:quality:(60 70 80 85 90 95)' \
	'(-H --height)'{-H,--height}'[also resize the image to given height]:height:' \
	'(-v --verbose)'{-v,--verbose}'[show what the script is doing]' \
	'(-d --debug)'{-d,--debug}'[dump debug info into ./debug.txt file]' \
	'*:image:_km_files images'
